[Unit]
Description=Smart Livestock Health Backend Service
After=syslog.target network.target postgresql.service

[Service]
# User account to run the application (use ubuntu / standard on AWS EC2)
User=ubuntu
WorkingDirectory=/var/www/smartlivestock

# Execution Command pointing to your production jar file location
ExecStart=/usr/bin/java -jar /var/www/smartlivestock/app.jar --spring.profiles.active=prod
SuccessExitStatus=143

# Crash Recovery and Lifecycle management
Restart=always
RestartSec=10

# Environmental variables
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=PORT=8080

# Logging Configurations
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=smartlivestock-backend

[Install]
WantedBy=multi-user.target
